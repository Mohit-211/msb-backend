# production, development or test
NODE_ENV=development
# Port number
PORT=5000

#central user mysql connection
CENTRAL_MYSQL_HOST='localhost'
CENTRAL_MYSQL_USER='root'
CENTRAL_MYSQL_PASSWORD=''
CENTRAL_MYSQL_DB='MSB'
CENTRAL_MYSQL_PORT=3306

# JWT
# Secrets need at least 32 characters. Generate each one with: openssl rand -hex 32
JWT_SECRET=''
# Signs admin tokens. Must be different from JWT_SECRET.
ADMIN_JWT_SECRET=''
# Access token lifetime. The code currently treats this number as days.
JWT_ACCESS_EXPIRATION_MINUTES=30

# SMTP configuration options for the email service
# For testing, you can use a fake SMTP service like Ethereal: https://ethereal.email/create
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME='abc@gmail.com'
SMTP_PASSWORD=''
EMAIL_FROM='abc@gmail.com'

# Origins allowed to call the API, comma-separated (no spaces, no trailing slash)
ACCESSDOMAINS='http://localhost:3000,http://localhost:3001'
DEFAULT_API_DATA_LIMIT=15

# OpenAI key for story generation. Required: the server won't start without it.
OPENAI_KEY=''
# Chat model for story generation. Optional; defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o

# Absolute path to uploaded files (defaults to ./public/uploads)
STORAGE_DIR=/var/www/msb/storage
